     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"r", "=", 
       RowBox[{"Ceiling", "[", 
        RowBox[{"Log", "[", 
         RowBox[{"2", ",", "l"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"g", "=", "gZero"}], ";", "\[IndentingNewLine]", 
      RowBox[{"s", "=", "sZero"}], ";", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", "1"}], ",", " ", 
        RowBox[{"i", "<", "r"}], ",", " ", 
        RowBox[{"++", "i"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"g", "=", 
